# Copy this file to .env and fill in your own values. Never share .env.
# Generate a strong secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters
ADMIN_USERNAME=choose_a_private_admin_username
ADMIN_PASSWORD=replace_with_a_strong_local_password
# Optional: use ADMIN_PASSWORD_HASH instead of ADMIN_PASSWORD for a hashed password.
# Generate a hash with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
# ADMIN_PASSWORD_HASH=
FLASK_DEBUG=false
# Set true only when running behind HTTPS; keep false for localhost.
COOKIE_SECURE=false
